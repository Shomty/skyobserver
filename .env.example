# Google Gemini API key — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# Server port (optional, defaults to 3000)
PORT=3000
# Reverse-proxy hops in front of the app (1 = one ingress proxy, e.g. Railway/nginx; 0 = reached directly).
# Used to read the real client IP for rate limiting without trusting client-sent X-Forwarded-For.
TRUST_PROXY_HOPS=1

# Firebase configuration — copy values from your Firebase project settings.
# Local dev: copy firebase-applet-config.example.json → firebase-applet-config.json instead.
# Railway / CI: set these environment variables; firebase-applet-config.json is auto-generated at build time.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=your-app-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_ID=your-firestore-database-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_MEASUREMENT_ID=

# Optional: path to Swiss Ephemeris files (defaults to node_modules/swisseph/ephe if local ephe/ is absent)
# EPHE_PATH=/path/to/ephe

# /api/gemini (browser AI) requires a signed-in Firebase user. The server
# verifies ID tokens with this project id (falls back to firebase-applet-config.json).
# FIREBASE_PROJECT_ID is also used above for the client config.
# Per-user and global limits (optional):
# GEMINI_PER_MINUTE=20
# GEMINI_PER_DAY=300
# GEMINI_UNVERIFIED_PER_DAY=30   # email/password accounts that have not verified their email
# GEMINI_GLOBAL_PER_DAY=5000

# MCP connector (/mcp). Comma-separated clientId:sha256(key) entries.
# Generate with: node scripts/create-mcp-key.js <clientId>. Unset = /mcp returns 503.
# MCP_API_KEYS=acme:0123abcd...
# Per-client limits (optional): calculation calls per minute, AI reports per UTC day
# MCP_CALC_PER_MINUTE=120
# MCP_REPORTS_PER_DAY=50

# Optional: set to '1' for verbose server request logging
# DEBUG_SERVER_LOGS=1

# Public site URL — used for canonical links, sitemap, and Open Graph (no trailing slash)
# VITE_SITE_URL=https://thesoulblueprint.online

# Google Analytics 4 measurement ID (also injected into index.html at build time)
# VITE_GA_MEASUREMENT_ID=G-FSFQ96MPGT

# Google Tag Manager container ID
# VITE_GTM_ID=GTM-PN7TR3J7

# Google Search Console HTML tag verification content value
# VITE_GSC_VERIFICATION=your-verification-token

# Gift funnel client mock (default on in DEV). Set to 0 to hit /api/gift/* instead.
# Demo variants: ?mock=ok|duplicate|daily_cap|paused|invalid|network|expired
VITE_GIFT_MOCK=1
