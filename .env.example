# Google Gemini API key — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# Server port (optional, defaults to 3000)
PORT=3000

# Firebase configuration — copy values from your Firebase project settings.
# Local dev: copy firebase-applet-config.example.json → firebase-applet-config.json instead.
# Railway / CI: set these environment variables; firebase-applet-config.json is auto-generated at build time.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=your-app-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_ID=your-firestore-database-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_MEASUREMENT_ID=

# Optional: path to Swiss Ephemeris files (defaults to node_modules/swisseph/ephe if local ephe/ is absent)
# EPHE_PATH=/path/to/ephe

# Optional: set to '1' for verbose server request logging
# DEBUG_SERVER_LOGS=1
